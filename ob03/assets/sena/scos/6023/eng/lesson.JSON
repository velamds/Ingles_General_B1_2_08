exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "The Good Old Days", "type": "lesson_name"}, {"content": "When Things Were Different", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe events in the news in a range of social and work contexts.", "type": "primary"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_1"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_2"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_3"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_4"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_5"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_6"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_7"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations. ", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Adjectives About Feelings and Reactions", "type": "heading"}, {"content": "You talk about feelings and reactions using adjectives.  It is important to use the correct kind of adjective - it is common for English language learners to confuse the two kinds of adjectives when talking about feelings and reactions.", "type": "describer"}, {"content": "<ol><li><span class=\"strong\">-ed</span> adjectives<br/>Adjectives that end in <span class=\"strong\">-ed</span> are used to describe how a person feels,  like <span class=\"italic\">annoyed</span>, <span class=\"italic\"> fascinated</span>, <span class=\"italic\"> entertained</span>, <span class=\"italic\"> surprised<span>, <span class=\"italic\"> worried </span> or <span class=\"italic\"> tired</span>.<br/><br/><span class=\"italic\">I am annoyed.<br/>She is surprised.</span><br><br></li><li> <span class=\"strong\">-ing</span> adjectives<br/><br/>Adjectives that end in <span class=\"strong\">-ing </span> are used to describe things and situations</span>, like <span class=\"italic\">annoying</span>, <span class=\"italic\"> entertaining</span>, <span class=\"italic\"> surprising</span>, <span class=\"italic\"> worrying</span> or <span class=\"italic\">tiring</span>. These adjectives describe the <span class=\"strong\"> effect</span> something has on a person.<br/><br/><span class=\"italic\">The movie is entertaining.</span> (It makes me feel entertained.)<br/><span class=\"italic\">Work is tiring.</span> (It makes me feel tired.)</li></ol", "type": "text"}, {"content": "We were so excited when a new 45 came out.", "type": "example"}, {"content": "It's disappointing to see how different it is for kids these days.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Present Perfect Tense vs The Simple Past", "type": "heading"}, {"content": "You use the Present Perfect tense to talk about an action or event that is connected to the present in some way. <br/><br/>You use the Simple Past tense to talk about a finished action or event <span class=\"strong\">not</span> connected to the present.", "type": "describer"}, {"content": "It is common to mix both the Simple Past and Present Perfect when you tell anecdotes or reminisce about the past.", "type": "text"}, {"content": "When you can use the Present Perfect there is a connection between what happened in the past and now. You use time markers like: <span class=\"italic\">for</span>, <span class=\"italic\">just</span>, <span class=\"italic\">ever</span> with the Present Perfect.", "type": "text"}, {"content": "When you can use the Simple Past the time is always past. You use time markers connected with the past like:  <span class=\"italic\">then</span>, <span class=\"italic\">ago</span>, <span class=\"italic\">yesterday</span>, <span class=\"italic\">when I was \u2026 </span> with the Simple Past.", "type": "text"}, {"content": "I've seen how smart and adaptable kids are to new technology.", "type": "example"}, {"content": " We collected baseball cards when were kids.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "illegally", "type": "name"}, {"content": "against the law ", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Our idea of a good time was illegally jumping into the river.", "type": "example"}, {"content": "engenn7le08ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to tell stories.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "baseball card", "type": "name"}, {"content": "a card with a picture and information about famous baseball players", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We loved to collect baseball cards.", "type": "example"}, {"content": "engenn7le08ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "carefree", "type": "name"}, {"content": "without worries", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": " Example: We were carefree when we were children.", "type": "example"}, {"content": "engenn7le08ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "status", "type": "name"}, {"content": "an update on social media", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We didn't have statuses to like.", "type": "example"}, {"content": "engenn7le08ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "45", "type": "name"}, {"content": "the most common form of the vinyl single", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We were so excited when a new 45 came out.", "type": "example"}, {"content": "engenn7le08ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to give the heads up", "type": "name"}, {"content": "to give information", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My sister would give us the heads up when a new 45 was coming out.", "type": "example"}, {"content": "engenn7le08ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "single", "type": "name"}, {"content": "a short record or CD featuring one main one song or track", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We waited for a new single to come out.", "type": "example"}, {"content": "engenn7le08ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "record", "type": "name"}, {"content": "a thin plastic disk carrying music in grooves on each surface, for reproduction by a record player ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Teddy had a record player.", "type": "example"}, {"content": "engenn7le08ob03aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "generation", "type": "name"}, {"content": "all the people born around the same time ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Every older generation says the same thing about the younger generations.", "type": "example"}, {"content": "engenn7le08ob03aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rec room", "type": "name"}, {"content": "a room in a house, especially in the basement, used for recreation and entertainment", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Teddy had a record player in his rec room.", "type": "example"}, {"content": "engenn7le08ob03aud10", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "superior ", "type": "name"}, {"content": "better ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We believe that things for us were superior to the way things are now.", "type": "example"}, {"content": "engenn7le08ob03aud11", "type": "audio"}]}, {"content": "engenn7le08ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Interview someone from an older generation. ", "type": "text"}, {"content": "Ask them their opinion of the younger generations.", "type": "text"}, {"content": "Write a short summary of what they said, using adjectives, <span class=\"italic\">used to</span>/<span class=\"italic\">would</span> and the Present Perfect tense, if possible.", "type": "text"}, {"content": "Read your summary to a partner and compare the ideas in them.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I interview a person from an older generation.", "type": "text"}, {"content": "I ask their opinion.", "type": "text"}, {"content": "I write a summary of their opinion.", "type": "text"}, {"content": "I discuss my writing with a partner.", "type": "text"}]}]}